# Postgres connection string (Supabase or Neon)
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (email delivery)
RESEND_API_KEY=
EMAIL_FROM="Your Store <orders@yourdomain.com>"

# Supabase Storage — two buckets:
#  - SUPABASE_STORAGE_BUCKET: private, holds the digital files customers pay for
#  - SUPABASE_IMAGES_BUCKET: public, holds product photos shown in the catalog
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=digital-products
SUPABASE_IMAGES_BUCKET=product-images

# Admin auth — the password you type on the /#/admin login screen.
# Never commit the real value; set it in Vercel's environment variable settings.
ADMIN_PASSWORD=
# Random signing secret for the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public site URL, no trailing slash (used in Stripe redirect URLs and email links)
SITE_URL=http://localhost:3000
